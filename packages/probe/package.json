{
  "name": "@isitdownforturkey/probe",
  "version": "0.1.0",
  "description": "Volunteer probe agent for isitdownforturkey — runs from inside Turkish ISPs",
  "type": "module",
  "main": "./index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./security": {
      "types": "./src/security.ts",
      "import": "./src/security.ts"
    }
  },
  "bin": {
    "probe": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "check": "node index.js --once",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["turkey", "probe", "censorship", "reachability"],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "vitest": "^3.2.2",
    "@types/node": "^24.10.0",
    "typescript": "^5.8.3"
  }
}
