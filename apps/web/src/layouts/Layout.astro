---
/**
 * Main site layout — header, footer, Google Fonts, CSS reset.
 */
import type { Lang } from '../i18n/strings.js';
import { t } from '../i18n/strings.js';

interface Props {
  title: string;
  lang?: Lang;
  description?: string;
}

const { title, lang = 'tr', description } = Astro.props;
const L = t(lang, 'siteTitle');
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? t(lang, 'heroDesc')} />
    <meta name="theme-color" content="#f97316" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/base.css" />
    <title>{title} — {L}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${L}`} />
    <meta property="og:description" content={description ?? t(lang, 'heroDesc')} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} — ${L}`} />
    <meta name="twitter:description" content={description ?? t(lang, 'heroDesc')} />
    <script type="application/ld+json" hoist>
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": L,
        "description": t(lang, 'heroDesc'),
        "url": "https://isitdownforturkey.pages.dev",
        "inLanguage": lang,
      })}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t(lang, 'home')}</a>
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo">
          <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="#1a1a1a"/>
            <circle cx="16" cy="16" r="12" fill="#0a0a0a" stroke="#2a2a2a" stroke-width="1.5"/>
            <circle cx="11" cy="16" r="4" fill="#f97316" opacity="0.9"/>
            <circle cx="21" cy="16" r="4" fill="#22c55e" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="2s" repeatCount="indefinite"/>
            </circle>
          </svg>
          <span>{L}</span>
        </a>
        <nav aria-label="Primary">
          <a href="/">{t(lang, 'home')}</a>
          <a href="https://github.com/isitdownforturkey/isitdownforturkey" target="_blank" rel="noopener noreferrer">{t(lang, 'github')}</a>
        </nav>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>{t(lang, 'footerText')}</p>
        <p><a href="https://github.com/isitdownforturkey/isitdownforturkey" target="_blank" rel="noopener noreferrer">{t(lang, 'footerLink')}</a></p>
      </div>
    </footer>
  </body>
</html>
