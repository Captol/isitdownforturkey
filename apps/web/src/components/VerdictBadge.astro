---
/**
 * Verdict badge — shows status color and label.
 */
import type { Lang } from '../i18n/strings.js';
import { t } from '../i18n/strings.js';

interface Props {
  verdict: string;
  blockReason?: string;
  lang: Lang;
  confidence?: string;
}

const { verdict, blockReason, lang, confidence } = Astro.props;

const verdictClass = verdict === 'UP' ? 'dot-up'
  : verdict === 'BLOCKED' ? 'dot-blocked'
  : verdict === 'DOWN_GLOBALLY' || verdict === 'DEGRADED' ? 'dot-down'
  : 'dot-unknown';

const label = t(lang, `verdict${verdict}` as any) ?? verdict;
const pulseClass = verdict === 'UP' || verdict === 'BLOCKED' ? 'pulse' : '';
---

<span class={`verdict-badge ${verdictClass} ${pulseClass}`} aria-label={label}>
  <span class="verdict-dot" aria-hidden="true"></span>
  {label}
  {blockReason && (
    <span class="verdict-reason">
      — {t(lang, `blockReason${blockReason.replace('_', '')}` as any) ?? blockReason}
    </span>
  )}
</span>

<style>
  .verdict-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: 'Sora', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    padding: 0.625rem 1.25rem;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    letter-spacing: -0.01em;
  }
  .verdict-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
  .pulse .verdict-dot {
    animation: pulse-dot 2s ease-in-out infinite;
  }
  .dot-up .verdict-dot { background: var(--ok); box-shadow: 0 0 8px var(--ok-dim); }
  .dot-blocked .verdict-dot { background: var(--bad); box-shadow: 0 0 8px var(--bad-dim); }
  .dot-down .verdict-dot { background: var(--warn); box-shadow: 0 0 8px var(--warn-dim); }
  .dot-unknown .verdict-dot { background: var(--text-muted); }
  .verdict-reason {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text-muted);
    font-family: 'Inter', sans-serif;
  }
</style>
