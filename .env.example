# Root Environment Variables Template
# Copy to .env and fill in actual values

# Cloudflare (required for deployment)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

# Probe Ingest Security (HMAC secret for signing probe reports)
PROBE_HMAC_SECRET=

# Cloudflare R2 (optional, for storing screenshots)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# GitHub (for Actions secrets scanning)
GITHUB_TOKEN=
