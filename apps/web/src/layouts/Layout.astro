---
/**
 * Main site layout — header, footer, CSS reset.
 */
import type { Lang } from '../i18n/strings.js';
import { t } from '../i18n/strings.js';

interface Props {
  title: string;
  lang?: Lang;
  description?: string;
}

const { title, lang = 'tr', description } = Astro.props;
const L = t(lang, 'siteTitle');
---

<!doctype html>
<html lang={lang} dir={lang === 'tr' ? 'ltr' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? t(lang, 'heroDesc')} />
    <link rel="stylesheet" href="/css/base.css" />
    <title>{title} — {L}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="#main" class="skip-link">{t(lang, 'home')}</a>
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo">
          <span aria-hidden="true">🇹🇷</span>
          <span>{L}</span>
        </a>
        <nav aria-label="Primary">
          <a href="/">{t(lang, 'home')}</a>
          <a href="https://github.com/isitdownforturkey/isitdownforturkey" target="_blank" rel="noopener noreferrer">{t(lang, 'github')}</a>
        </nav>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>{t(lang, 'footerText')}</p>
        <p><a href="https://github.com/isitdownforturkey/isitdownforturkey" target="_blank" rel="noopener noreferrer">{t(lang, 'footerLink')}</a></p>
      </div>
    </footer>
  </body>
</html>
